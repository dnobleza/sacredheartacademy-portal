# Copy this file to .env and fill in the real values.
# Never commit .env — it is ignored by .gitignore.

# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sacred_heart_academy
# Set to true for managed MySQL that requires TLS (Aiven, PlanetScale, TiDB Cloud)
DB_SSL=false
# PEM contents of the provider's CA certificate. Required when DB_SSL=true and
# the provider signs with its own CA (Aiven). Paste the full certificate,
# BEGIN/END lines included. Escaped newline sequences are also accepted, so the
# certificate can be stored on a single line if the host requires it.
DB_SSL_CA=

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
